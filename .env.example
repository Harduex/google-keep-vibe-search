# Required — path to Google Keep Takeout export folder
GOOGLE_KEEP_PATH=

# LLM provider: ollama, openai, anthropic, or any LiteLLM-supported
LLM_PROVIDER=ollama
LLM_API_BASE_URL=http://localhost:11434
LLM_API_KEY=
LLM_MODEL=ornith-1.0-9b

# Optional tuning (uncomment to override defaults)
# MAX_RESULTS=300
# SEARCH_THRESHOLD=0.3
# EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# LLM_TEMPERATURE=0.1
# LLM_MAX_TOKENS=2048
# CHAT_CONTEXT_NOTES=10
# CHAT_MAX_RECENT_MESSAGES=6
# CHAT_SUMMARIZATION_THRESHOLD=12

# AGENT_MAX_STEPS=5
# ENABLE_IMAGE_SEARCH=true
# IMAGE_SEARCH_THRESHOLD=0.2
# CACHE_DIR=
# FORCE_CACHE_REFRESH=false
